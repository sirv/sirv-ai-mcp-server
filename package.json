{
  "name": "sirv-ai-mcp-server",
  "mcpName": "io.github.sirv/sirv-ai-mcp-server",
  "version": "1.1.0",
  "description": "MCP server for Sirv AI Studio - AI-powered image and video processing",
  "author": "Sirv Ltd (https://www.sirv.studio)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sirv/sirv-ai-mcp-server"
  },
  "homepage": "https://www.sirv.studio",
  "bugs": {
    "url": "https://github.com/sirv/sirv-ai-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai",
    "image-processing",
    "background-removal",
    "upscaling",
    "image-generation",
    "video-generation",
    "3d-generation",
    "claude",
    "anthropic",
    "sirv"
  ],
  "files": [
    "dist",
    "!dist/__tests__",
    "public",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sirv-ai-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "dev": "SIRV_AI_BASE_URL=${SIRV_AI_BASE_URL:-http://localhost:3000} tsx watch src/index.ts",
    "dev:http": "SIRV_AI_BASE_URL=${SIRV_AI_BASE_URL:-http://localhost:3000} MCP_TRANSPORT=http tsx watch src/index.ts",
    "dev:inspector": "SIRV_AI_BASE_URL=${SIRV_AI_BASE_URL:-http://localhost:3000} MCP_TRANSPORT=http MCP_SKIP_AUTH=true tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "bun check",
    "typecheck:fast": "bun check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "axios": "^1.20.0",
    "express": "^4.21.0",
    "jose": "^6.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
